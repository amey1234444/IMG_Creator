HF_TOKEN=
IMG_CREATOR_DEVICE=auto
IMG_CREATOR_OUTPUT_DIR=outputs
IMG_CREATOR_CPU_OFFLOAD=true
# Optional Hugging Face revision; must exist for both selected model repositories.
IMG_CREATOR_MODEL_REVISION=
# Trusted RGB 2x/4x Real-ESRGAN or SwinIR weights. Never supplied by API users.
IMG_CREATOR_SR_WEIGHTS=
IMG_CREATOR_TILE_SIZE=256
# Administrator-managed JSON registry; see docs/lora_registry.example.json.
IMG_CREATOR_LORA_REGISTRY=
# Local API is unauthenticated by default. Set before exposing through a reverse proxy.
IMG_CREATOR_API_KEY=
