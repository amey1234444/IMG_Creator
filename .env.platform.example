# Load explicitly with: set -a; source .env.platform; set +a
DATABASE_URL=sqlite:///platform.db
PUBLIC_URL=http://localhost:8000
COOKIE_SECURE=false
PLATFORM_STORAGE_DIR=platform-data
BFL_API_KEY=
ENABLED_MODELS=flux-2-klein-4b,flux-2-klein-9b,flux-2-pro,flux-2-flex,flux-2-max
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Required for multi-service deployment; keep the bucket private.
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Enable only when the matching GPU worker and license are ready.
LOCAL_MODELS_ENABLED=false
FLUX_DEV_COMMERCIAL_LICENSE=false
OPENAI_MODERATION_KEY=
IMG_CREATOR_DEVICE=cuda
# Set this path on the web service (capability flag) AND on the GPU worker.
# Trusted RGB 2x/4x Spandrel checkpoint, with external tiling support.
IMG_CREATOR_SR_WEIGHTS=
IMG_CREATOR_TILE_SIZE=256
IMG_CREATOR_TILE_PAD=64
HF_TOKEN=

EXPOSE_API_DOCS=false
API_REQUESTS_PER_MINUTE=300
# Mount a persistent GPU-worker volume here. Never use the ephemeral container disk.
TRAINING_WORK_DIR=training-work
