FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
COPY training ./training
RUN pip install --no-cache-dir '.[platform]' && useradd --create-home --uid 10001 studio && chown -R studio:studio /app
USER studio
EXPOSE 8000
CMD ["sh", "-c", "uvicorn img_creator.platform.app:app --host 0.0.0.0 --port ${PORT:-8000} --no-proxy-headers"]
